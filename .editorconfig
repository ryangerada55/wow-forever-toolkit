# EditorConfig for the whole toolkit (https://editorconfig.org): UTF-8 without BOM, LF, a final
# newline, no trailing whitespace. VS Code needs the "EditorConfig.EditorConfig" extension.
# devsetup/.editorconfig holds the same rules as a file to copy into addon repositories.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TOC files must stay UTF-8 *without* a BOM ("utf-8" in EditorConfig means no BOM).
[*.toc]
charset = utf-8

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# Test fixture that starts with a UTF-8 BOM on purpose (patchwatch must read it). The devsetup
# fixture with a BOM has its own .editorconfig next to it.
[patchwatch/tests/fixtures/addons/PatchwatchFixture/PatchwatchFixture_Camelot.toc]
charset = unset
